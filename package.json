{
  "name": "arbolito",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify:addresses": "node scripts/run.mjs verify-addresses",
    "quote": "node scripts/run.mjs quote",
    "smoke:convert": "node scripts/run.mjs smoke-convert",
    "deploy:receipts": "pnpm contracts:build && node scripts/run.mjs deploy-receipts",
    "register:8004": "node scripts/run.mjs register-8004",
    "reanchor:receipt": "node scripts/run.mjs reanchor-receipt",
    "verify:receipt": "node scripts/run.mjs verify-receipt",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:test:fork": "forge test --root contracts --match-path \"test/fork/*\" --fork-url https://forno.celo.org",
    "test": "pnpm contracts:test && vitest run",
    "test:unit": "vitest run --project unit",
    "test:fork": "pnpm contracts:build && vitest run --project fork",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "pnpm --filter @arbolito/db db:generate",
    "db:migrate": "pnpm --filter @arbolito/db db:migrate",
    "test:db": "vitest run --project db",
    "grow:oracle": "node scripts/run.mjs grow-oracle",
    "desk:feed": "node scripts/run.mjs desk-feed",
    "desk:stitch-config": "node scripts/run.mjs desk-stitch-config"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@arbolito/chain": "workspace:*",
    "@arbolito/config": "workspace:*",
    "@arbolito/desk": "workspace:*",
    "@arbolito/proof": "workspace:*",
    "@arbolito/router": "workspace:*",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  }
}
