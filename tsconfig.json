{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "test/**/*.ts", "apps/*/src/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  // apps/web is a Next.js app with its own tsconfig (DOM + JSX): pnpm --filter @arbolito/web typecheck
  "exclude": ["apps/web/**", "**/node_modules/**"]
}
