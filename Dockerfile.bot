# Arbolito Telegram bot (apps/agent). Built by Railway via railway.json.
FROM node:22-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NODE_ENV=production
RUN npm install -g pnpm@11.1.2 && apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
# Only the bot and the workspace packages it depends on; lockfile must match.
RUN pnpm install --frozen-lockfile --filter "@arbolito/agent..." --prod=false
USER node
CMD ["pnpm", "--filter", "@arbolito/agent", "start"]
