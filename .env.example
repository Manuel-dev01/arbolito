# ── Chain ──────────────────────────────────────────────
CELO_RPC_URL=https://forno.celo.org
# Chainstack RPC (hackathon perk) once available
CELO_RPC_URL_FALLBACK=
CHAIN_ID=42220
# ERC-8021 attribution code issued at hackathon registration (celo_xxxxxxxx)
ATTRIBUTION_CODE=

# ── Wallets (NEVER commit real values) ─────────────────
# Ops/treasury wallet: deploys contracts, holds the USA₮ treasury
OPS_PRIVATE_KEY=
# Desk hot wallet (Textile filler inventory; capped)
DESK_PRIVATE_KEY=
DESK_MAX_INVENTORY_USD=500
# Per-action and daily spend caps while building (USD)
BUILD_MAX_ACTION_USD=5
BUILD_MAX_DAILY_USD=25

# ── Textile FX ─────────────────────────────────────────
TEXTILE_API_BASE=https://api.textilecredit.com/v2
# Public (no-auth) feeds: /tickers, /pairs, /historical_trades
TEXTILE_PUBLIC_BASE=https://api.textilecredit.com
# tx_live_… (request from contact@textilecredit.com)
TEXTILE_API_KEY=
TEXTILE_WEBHOOK_SECRET=
# RFQ taker adapter stays off until a live key exists and the v2 spec is verified
TEXTILE_RFQ_ENABLED=false

# ── Reference rates ────────────────────────────────────
# dolarapi.com base: /dolares (ARS official, MEP, CCL, crypto) and /cotizaciones (BRL→ARS official)
DOLAR_API_URL=https://dolarapi.com/v1

# ── Celo x402 facilitator ──────────────────────────────
X402_FACILITATOR_URL=https://api.x402.celo.org
# from x402.celo.org (needed for /settle)
X402_API_KEY=
# where Arbolito's FX API receives payment
X402_PAY_TO=

# ── buy (x402 marketplace) ─────────────────────────────
BUY_GATEWAY_URL=https://gateway.usebuy.ai
BUY_COMPUTE_URL=https://usebuy.ai/google/vm
# buy's own wallet lives in the OS keychain via `npx @celo/buy setup`; for programmatic
# server-side payments use a dedicated capped wallet:
BUY_PAYER_PRIVATE_KEY=
BUY_PAY_TOKEN=USAT

# ── LLM / speech ───────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
RISK_OFFICER_MODEL=claude-opus-5-5
# Whisper-class STT provider for voice notes (e.g. Groq or Deepgram)
STT_PROVIDER=
STT_API_KEY=

# ── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=

# ── Wallet infra (smart accounts / session keys) ───────
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# ── Identity ───────────────────────────────────────────
ERC8004_AGENT_ID=
SELF_AGENT_ID=

# ── Data ───────────────────────────────────────────────
# Postgres (Neon/Supabase)
DATABASE_URL=

# ── Web ────────────────────────────────────────────────
PUBLIC_BASE_URL=
