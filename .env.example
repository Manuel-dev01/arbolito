# ── Chain ──────────────────────────────────────────────
CELO_RPC_URL=https://forno.celo.org
# Chainstack RPC (hackathon perk) once available
CELO_RPC_URL_FALLBACK=
CHAIN_ID=42220
# ERC-8021 attribution code issued at hackathon registration (celo_xxxxxxxx)
ATTRIBUTION_CODE=

# ── Wallets (NEVER commit real values) ─────────────────
# Ops/treasury wallet: deploys contracts, holds the USA₮ treasury
OPS_PRIVATE_KEY=
# Desk hot wallet (Textile filler inventory; capped)
DESK_PRIVATE_KEY=
DESK_MAX_INVENTORY_USD=500
# Desk pricing feed (apps/desk): the desk wallet's PUBLIC address (inventory reads, no key) and the port Stitch polls
DESK_ADDRESS=
DESK_FEED_PORT=8790
# Public HTTPS address of the desk feed (Stitch reads it; the /desk page shows its /state)
DESK_FEED_PUBLIC_URL=https://desk-feed-production.up.railway.app
# LLM risk officer on the desk feed (may only pause a corridor 15–120 min); needs DEEPSEEK_API_KEY. Off by default.
DESK_RISK_OFFICER=false
# Run Stitch inside the desk-feed service (enables inventory caps). Path to the stitch binary (the Docker image sets it)
# and the Textile maker credential from `stitch connect`. Stitch signs with DESK_PRIVATE_KEY.
DESK_STITCH_BIN=
DESK_RFQ_API_KEY=
# Per-action and daily spend caps while building (USD)
BUILD_MAX_ACTION_USD=5
BUILD_MAX_DAILY_USD=25

# ── Textile FX ─────────────────────────────────────────
TEXTILE_API_BASE=https://api.textilecredit.com/v2
# Public (no-auth) feeds: /tickers, /pairs, /historical_trades
TEXTILE_PUBLIC_BASE=https://api.textilecredit.com
# Optional partner key tx_live_… (contact@textilecredit.com). Taker paths work keyless:
# preview needs nothing; firm requests are signed by the taker wallet (TakerControl, EIP-712)
TEXTILE_API_KEY=
TEXTILE_WEBHOOK_SECRET=
# Firm quotes + Textile-leg execution (locks maker inventory; taker must hold the sell token).
# Previews always run. Keep false until a funded taker has exercised it on mainnet.
TEXTILE_RFQ_ENABLED=false

# ── Reference rates ────────────────────────────────────
# dolarapi.com base: /dolares (ARS official, MEP, CCL, crypto) and /cotizaciones (BRL→ARS official)
DOLAR_API_URL=https://dolarapi.com/v1

# ── Celo x402 facilitator ──────────────────────────────
X402_FACILITATOR_URL=https://api.x402.celo.org
# from x402.celo.org (needed for /settle)
X402_API_KEY=
# where Arbolito's FX API receives payment
X402_PAY_TO=

# ── buy (x402 marketplace) ─────────────────────────────
BUY_GATEWAY_URL=https://gateway.usebuy.ai
BUY_COMPUTE_URL=https://usebuy.ai/google/vm
# buy's own wallet lives in the OS keychain via `npx @celo/buy setup`; for programmatic
# server-side payments use a dedicated capped wallet:
BUY_PAYER_PRIVATE_KEY=
BUY_PAY_TOKEN=USAT

# ── LLM / speech ───────────────────────────────────────
# Provider for the chat agent and the desk risk officer: deepseek (default) or anthropic
LLM_PROVIDER=deepseek
# platform.deepseek.com → API keys (prepaid balance). OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model IDs for the active provider. DeepSeek /models on 2026-10-09: deepseek-flash, deepseek-v4-pro
AGENT_MODEL=deepseek-flash
RISK_OFFICER_MODEL=deepseek-v4-pro
# Whisper-class STT provider for voice notes: groq (whisper-large-v3-turbo) or deepgram
STT_PROVIDER=groq
STT_API_KEY=

# ── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=
# Private beta: comma-separated Telegram numeric ids and/or @usernames the bot answers.
# Empty = open to everyone. Prefer numeric ids (usernames can change hands).
TELEGRAM_ALLOWED_USERS=

# ── Wallet infra (smart accounts / session keys) ───────
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# ── Identity ───────────────────────────────────────────
ERC8004_AGENT_ID=
SELF_AGENT_ID=

# ── Data ───────────────────────────────────────────────
# Postgres (Neon via Vercel marketplace). Pooled (-pooler) for app traffic;
# direct/unpooled for drizzle-kit migrations (pooled PgBouncer breaks them).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Web ────────────────────────────────────────────────
PUBLIC_BASE_URL=

# ── MiniPay Mini App backend (apps/web) ────────────────
# Receipt anchoring from /api/miniapp/submit (gas only; a capped hot key, emitter on ArbolitoReceipts).
# Created by `pnpm anchor:wallet init` (gas-only; an ArbolitoReceipts emitter). Live on Vercel since 2026-10-19.
ANCHOR_PRIVATE_KEY=
ANCHOR_ENABLED=false
# ArbolitoGuard v2 address and the operator EOA it authorizes (autonomy). Unset = not_ready.
GUARD_ADDRESS=
ARBOLITO_OPERATOR_ADDRESS=
