{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm install --frozen-lockfile --filter @arbolito/agent..."
  },
  "deploy": {
    "startCommand": "pnpm --filter @arbolito/agent start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
